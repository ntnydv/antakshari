{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:antakshari:private-role-view:v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "promptId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "recipientUid": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "expiryMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "role": {
      "const": "hummer"
    },
    "songId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "displayTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "schemaVersion",
    "promptId",
    "recipientUid",
    "expiryMs",
    "role",
    "songId",
    "displayTitle"
  ],
  "additionalProperties": false
}
