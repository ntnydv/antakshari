{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:antakshari:attempt:v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "attemptId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "actor": {
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "teamId": {
          "type": "string",
          "enum": [
            "A",
            "B"
          ]
        }
      },
      "required": [
        "uid",
        "teamId"
      ],
      "additionalProperties": false
    },
    "mediaDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "granted",
        "capturing",
        "sealed",
        "adjudicating",
        "review_pending",
        "settled",
        "cancelled"
      ]
    },
    "sealedAtMs": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "decisionRef": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "attemptId",
    "generation",
    "actor",
    "mediaDigest",
    "phase",
    "sealedAtMs",
    "decisionRef"
  ],
  "additionalProperties": false
}
