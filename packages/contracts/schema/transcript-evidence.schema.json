{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:antakshari:transcript-evidence:v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "attemptId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "model": {
      "const": "muse-voice-transcribe-1.0"
    },
    "text": {
      "type": "string",
      "maxLength": 8000
    },
    "final": {
      "type": "boolean"
    },
    "observedAudioDurationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20000
    },
    "mode": {
      "type": "string",
      "enum": [
        "PUSH_TO_TALK",
        "CONTINUOUS"
      ]
    },
    "language": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 8000
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "maxItems": 50
    },
    "captureTiming": {
      "type": "object",
      "properties": {
        "origin": {
          "const": "application_capture"
        },
        "startAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "origin",
        "startAtMs",
        "endAtMs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "attemptId",
    "model",
    "text",
    "final",
    "observedAudioDurationMs",
    "mode"
  ],
  "additionalProperties": false
}
