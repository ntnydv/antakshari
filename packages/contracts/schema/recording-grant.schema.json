{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:antakshari:recording-grant:v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "attemptId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "uid": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "matchId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "promptId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000000
    },
    "sampleRate": {
      "type": "integer",
      "enum": [
        16000,
        24000
      ]
    },
    "direction": {
      "type": "string",
      "enum": [
        "capture",
        "listen"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "attemptId",
    "uid",
    "matchId",
    "promptId",
    "generation",
    "expiresAtMs",
    "maxBytes",
    "sampleRate",
    "direction"
  ],
  "additionalProperties": false
}
